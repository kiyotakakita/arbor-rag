# ==============================================================================
# DecisionRAG Configuration
# ==============================================================================

# Catalog & Dataset
DATA_PATH="data/sample_catalog.json"

# Hierarchical Navigation & Tree Pruning
MAX_DEPTH=4
BRANCH_TOP_K=2
PRUNE_THRESHOLD=0.25

# Dense Hybrid Candidate Rescue (Vector Fallback)
ENABLE_DENSE_HYBRID=true
DENSE_TOP_N=3
HYBRID_ALPHA=0.7

# Final Listwise Results
FINAL_TOP_K=5

# Decision Model Backend ("mock", "cross_encoder", "llm")
DECISION_MODEL_TYPE="mock"

# Optional LLM API Key (when DECISION_MODEL_TYPE="llm")
GEMINI_API_KEY=""

# Server Network Settings
API_HOST="0.0.0.0"
API_PORT=8000
LOG_LEVEL="INFO"
